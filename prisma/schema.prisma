// Prisma schema — Ekosistem Presensi & Perkembangan Ekstrakurikuler SD
//
// FASE 0: hanya datasource + generator sebagai kerangka.
// Konversi lengkap dari DDL (system-design-ekosistem-ekskul-sd.md bagian 3.2)
// menjadi model Prisma + migration files dikerjakan pada prompt Fase 0.2.
//
// Referensi: docs -> ../../system-design-ekosistem-ekskul-sd.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

