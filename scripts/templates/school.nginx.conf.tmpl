# nginx sekolah "@@CODE@@" — dibuat oleh scripts/provision-school.sh.
# Diletakkan di @@NGINX_DIR@@/@@CODE@@.conf lalu `nginx -t && systemctl reload nginx`
# (atau reload container nginx bersama). certbot menambah blok 443 + redirect.

server {
    listen 80;
    listen [::]:80;
    server_name @@CODE@@.@@BASE_DOMAIN@@;

    root /var/www/eskul-admin;      # build panel admin BERSAMA (satu untuk semua sekolah)
    index index.html;

    client_max_body_size 20m;       # impor siswa .xlsx
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://eskul-api-@@CODE@@:3000;   # via jaringan compose eskul-net
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|woff2?|png|jpg|svg)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
