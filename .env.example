# ==========================================================
# eskul-backend — contoh environment. Salin ke .env lalu isi.
# ==========================================================

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Database (PostgreSQL) ---
# Saat pakai docker-compose, host = "postgres". Untuk run lokal non-docker, host = "localhost".
DATABASE_URL=postgresql://eskul:eskul_secret@localhost:5432/eskul?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT (dipakai mulai Fase 1.1) ---
JWT_ACCESS_SECRET=ganti-dengan-string-acak-panjang
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=ganti-dengan-string-acak-panjang-lain
JWT_REFRESH_TTL=30d

# --- Object storage S3-compatible (dipakai mulai Fase 3) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eskul-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SIGNED_URL_TTL=300

# --- Firebase Cloud Messaging (dipakai mulai Fase 1.5) ---
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=./secrets/fcm-service-account.json

# --- CORS: daftar origin dipisah koma ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
