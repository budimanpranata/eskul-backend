# ==========================================================
# eskul-backend — contoh environment. Salin ke .env lalu isi.
# ==========================================================

NODE_ENV=development
# Port 3000 sering dipakai tool lain (Grafana, dsb.) — default dev di sini 3100.
PORT=3100
API_PREFIX=api/v1

# Port host untuk container "api" saat `docker compose up` (internal tetap 3000).
API_HOST_PORT=3100

# --- Port host untuk container (docker-compose) ---
# Ganti bila 5432/6379 sudah dipakai PostgreSQL/Redis lain di mesin Anda.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=63790

# --- Database (PostgreSQL) ---
# Backend dijalankan via Node di host  -> host 127.0.0.1 + POSTGRES_HOST_PORT.
# Backend dijalankan via service "api" di docker-compose -> host "postgres" port 5432
# (di-set langsung di docker-compose.yml, tidak dari file ini).
DATABASE_URL=postgresql://eskul:eskul_secret@127.0.0.1:55432/eskul?schema=public

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=63790
REDIS_PASSWORD=

# --- JWT (dipakai mulai Fase 1.1) ---
JWT_ACCESS_SECRET=ganti-dengan-string-acak-panjang
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=ganti-dengan-string-acak-panjang-lain
JWT_REFRESH_TTL=30d

# --- Object storage S3-compatible (dipakai mulai Fase 3) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eskul-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SIGNED_URL_TTL=300

# --- Export laporan (Fase 3.1) ---
# Bila S3_ACCESS_KEY kosong, file export disimpan ke direktori lokal ini.
REPORT_STORAGE_DIR=./storage/reports
# Umur signed URL unduhan (detik). Default 1 jam.
REPORT_SIGNED_URL_TTL=3600
# Rahasia HMAC penanda-tangan URL unduhan. Kosong -> pakai JWT_ACCESS_SECRET.
REPORT_SIGNING_SECRET=

# --- Firebase Cloud Messaging (dipakai mulai Fase 1.5) ---
# Bila FCM_CREDENTIALS_PATH menunjuk service-account JSON yang ada -> FirebasePushSender.
# Jika tidak -> LoggingPushSender (dev: hanya mencatat, tidak mengirim).
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=./secrets/fcm-service-account.json
# Dev/test: csv substring token yang disimulasikan GAGAL (untuk uji retry/DLQ). Kosongkan di produksi.
PUSH_FAIL_TOKENS=

# --- CORS: daftar origin dipisah koma ---
CORS_ALLOWED_ORIGINS=http://localhost:5273
